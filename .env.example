ENVIRONMENT=development
POSTGRES_USER=hedgehoog
POSTGRES_PASSWORD=hedgehoog-local
POSTGRES_DB=hedgehoog
DATABASE_URL=postgresql://hedgehoog:hedgehoog-local@127.0.0.1:5432/hedgehoog
# make setup replaces this placeholder with a random secret in .env.
JWT_SECRET=GENERATE_WITH_MAKE_SETUP
JWT_EXPIRE_MINUTES=43200
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
COOKIE_SECURE=false
ALLOW_INSECURE_HTTP=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_MAX_CONNECTIONS=20
JOB_POLL_INTERVAL_MS=500
JOB_LEASE_SECONDS=120
# Safety bounds, not a provider subscription/quota allowance.
MARKET_DATA_MAX_CALLS_PER_JOB=40
MARKET_DATA_TIMEOUT_SECONDS=15
# Parallel acquisition tasks; catalogue work stays serial.
MARKET_DATA_WORKER_CONCURRENCY=16
# Global spacing between Yahoo HTTP starts across workers (0 disables pacing).
YAHOO_REQUEST_INTERVAL_SECONDS=0.05
# Retain latest complete Yahoo history; daily catch-up prunes superseded payloads.
MARKET_DATA_RETENTION_ENABLED=true
MARKET_DATA_RETENTION_BATCH_SIZE=1000
