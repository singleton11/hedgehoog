ENVIRONMENT=development
MONGO_ROOT_USERNAME=hedgehoog
MONGO_ROOT_PASSWORD=hedgehoog-local
MONGODB_URI=mongodb://hedgehoog:hedgehoog-local@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=hedgehoog
RABBITMQ_USER=hedgehoog
RABBITMQ_PASSWORD=hedgehoog-local
CELERY_BROKER_URL=amqp://hedgehoog:hedgehoog-local@127.0.0.1:5672//
# Compose derives worker URLs with service hostnames from the credentials above.
# Override these for external services or separately URL-encoded credentials:
# WORKER_MONGODB_URI=mongodb://user:password@mongodb:27017/?authSource=admin
# WORKER_CELERY_BROKER_URL=amqp://user:password@rabbitmq:5672//
# make setup replaces this placeholder with a random secret in .env.
JWT_SECRET=GENERATE_WITH_MAKE_SETUP
JWT_EXPIRE_MINUTES=60
# Server/worker only; never expose this key through Vite or commit it.
MARKETSTACK_API_KEY=
# Conservative local monthly allowance, separate from the provider dashboard.
# Set to your remaining allowance; 0 disables paid API calls. External usage is unknown.
# Current paid plan: 10000 requests/month; set explicitly to enable on-demand acquisition.
MARKETSTACK_MONTHLY_BUDGET=0
MARKETSTACK_MAX_CALLS_PER_JOB=12
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
